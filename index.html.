};
const $=id=>document.getElementById(id);let chosen=null,amount=0;
function render(){let g=$("game").value;$("method").innerHTML=data[g].methods.map(x=>`<option>${x}</option>`).join("");$("targetLabel").textContent=(g==="ff"||g==="pubg")?"Player ID":"اسم المستخدم";renderPacks()}
function renderPacks(){let list=data[$("game").value].prices[$("method").value]||[];chosen=null;amount=0;$("packs").innerHTML=list.map((x,i)=>`<button class="pack" data-i="${i}"><b>${x[0]}</b><span>${x[1]} جنيه</span></button>`).join("");document.querySelectorAll(".pack").forEach(b=>b.onclick=()=>{document.querySelectorAll(".pack").forEach(x=>x.classList.remove("active"));b.classList.add("active");chosen=list[+b.dataset.i][0];amount=list[+b.dataset.i][1]})}
$("game").onchange=render;$("method").onchange=renderPacks;document.querySelectorAll(".game").forEach(b=>b.onclick=()=>{$("game").value=b.dataset.game;document.querySelectorAll(".game").forEach(x=>x.classList.toggle("active",x===b));render()});render();
$("send").onclick=async()=>{let target=$("target").value.trim(),phone=$("phone").value.trim(),ref=$("reference").value.trim();if(!chosen)return alert("اختار الباقة");if(!target||!phone||!ref)return alert("اكمل البيانات");if(/password|pass|كلمة\s*المرور|باسورد/i.test(target))return alert("لا تدخل كلمات مرور");$("send").disabled=true;let no="KAS-"+Date.now().toString().slice(-9);let r=await db.from("orders").insert({order_number:no,game:$("game").selectedOptions[0].text,package_name:chosen,delivery_method:$("method").value,player_id:target,customer_phone:phone,payment_method:$("payment").value,payment_reference:ref,amount,status:"pending"});$("send").disabled=false;$("status").style.display="block";$("status").textContent=r.error?"تعذر إرسال الطلب: "+r.error.message:"استلمنا طلبك رقم "+no+" وهو قيد المراجعة."};
$("login").onclick=async()=>{let r=await db.auth.signInWithPassword({email:$("email").value.trim(),password:$("password").value});if(r.error)return alert(r.error.message);$("loginbox").style.display="none";$("admin").style.display="block";load()};
async function load(){let box=$("orders");box.textContent="تحميل الطلبات...";let r=await db.from("orders").select("*").order("created_at",{ascending:false}).limit(100);if(r.error){box.textContent=r.error.message;return}box.innerHTML="";r.data.forEach(o=>{let d=document.createElement("div");d.className="order";let t=document.createElement("b");t.textContent=`${o.order_number} | ${o.game} | ${o.package_name} | ${o.amount} ج`;let p=document.createElement("p");p.className="muted";p.textContent=`${o.delivery_method} | ${o.player_id} | ${o.customer_phone} | ${o.payment_method} | ${o.payment_reference}`;let s=document.createElement("select");[["pending","قيد المراجعة"],["reviewing","جارٍ التنفيذ"],["completed","مكتمل"],["rejected","مرفوض"]].forEach(([v,n])=>{let op=document.createElement("option");op.value=v;op.textContent=n;op.selected=o.status===v;s.append(op)});let b=document.createElement("button");b.textContent="حفظ الحالة";b.onclick=async()=>{let x=await db.from("orders").update({status:s.value}).eq("id",o.id);alert(x.error?x.error.message:"تم التحديث")};d.append(t,p,s,b);box.append(d)})}
$("refresh").onclick=load;$("logout").onclick=async()=>{await db.auth.signOut();$("loginbox").style.display="block";$("admin").style.display="none"};
</script></body></html>
